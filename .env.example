# ----- Database -----
# Used by both the app and drizzle-kit.
# Defaults assume `pnpm dev` running against the dockerised db on localhost.
# Inside docker-compose the app gets DATABASE_URL=postgres://...@db:5432/... injected.
DATABASE_URL=postgres://skat:skat@localhost:5432/skat

POSTGRES_USER=skat
POSTGRES_PASSWORD=skat
POSTGRES_DB=skat

# ----- better-auth -----
# Generate a 32+ byte random secret, e.g.: openssl rand -base64 32
BETTER_AUTH_SECRET=

# Public origin (used for OAuth callbacks and magic-link URLs).
BETTER_AUTH_URL=http://localhost:3000

# ----- Google OAuth -----
# Create credentials at https://console.cloud.google.com → OAuth 2.0.
# Authorised redirect URI: ${BETTER_AUTH_URL}/api/auth/callback/google
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# ----- SMTP (Mailpit by default) -----
# In dev (pnpm dev) we hit Mailpit on localhost:1025; inside compose the app
# uses host=mailpit (overridden in docker-compose.yml).
# Mailpit captures mail locally — view it at http://localhost:8025.
# To enable real delivery, point these at any SMTP relay (Resend / Postmark /
# SES / Mailgun / your provider).
SMTP_HOST=localhost
SMTP_PORT=1025
SMTP_USER=
SMTP_PASS=
SMTP_FROM=Skatstatistik <noreply@skatstatistik.local>

# ----- First admin -----
# This email is auto-promoted to admin on first sign-in. Leave empty until
# you know which email you'll use to bootstrap.
ADMIN_EMAIL=
