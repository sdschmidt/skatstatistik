{
	"name": "skatstatistik",
	"private": true,
	"version": "0.0.1",
	"type": "module",
	"engines": {
		"node": ">=20"
	},
	"scripts": {
		"dev": "vite dev",
		"build": "vite build",
		"preview": "vite preview",
		"start": "node build/index.js",
		"prepare": "svelte-kit sync || echo ''",
		"check": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json",
		"db:generate": "drizzle-kit generate",
		"db:migrate": "node --env-file=.env scripts/migrate.js",
		"db:studio": "drizzle-kit studio",
		"seed": "tsx --env-file=.env scripts/seed.ts"
	},
	"devDependencies": {
		"@sveltejs/adapter-node": "^5.2.13",
		"@sveltejs/kit": "^2.57.0",
		"@sveltejs/vite-plugin-svelte": "^7.0.0",
		"@tailwindcss/vite": "^4.1.0",
		"@types/node": "^22.10.0",
		"@types/nodemailer": "^6.4.23",
		"dotenv": "^17.0.0",
		"drizzle-kit": "^0.31.0",
		"svelte": "^5.55.2",
		"svelte-check": "^4.4.6",
		"tailwindcss": "^4.1.0",
		"tsx": "^4.20.0",
		"typescript": "^6.0.2",
		"vite": "^8.0.7"
	},
	"dependencies": {
		"apexcharts": "^4.4.0",
		"better-auth": "^1.2.0",
		"drizzle-orm": "^0.45.2",
		"flowbite": "^3.1.0",
		"flowbite-svelte": "^1.0.0",
		"nodemailer": "^6.10.1",
		"postgres": "^3.4.5"
	},
	"pnpm": {
		"onlyBuiltDependencies": [
			"esbuild"
		]
	}
}
